{
  "name": "mycontext-mcp-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ./wrangler.jsonc --name mycontext-mcp",
    "deploy": "node ./scripts/release.mjs",
    "deploy:dry-run": "wrangler deploy --dry-run --strict --config ./wrangler.jsonc --name mycontext-mcp",
    "release:preflight": "node ./scripts/release.mjs --preflight-only",
    "verify:public-mcp": "node ./scripts/verify-public-mcp.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tail": "wrangler tail --config ./wrangler.jsonc --name mycontext-mcp"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@tidbcloud/serverless": "^0.3.0",
    "agents": "0.28.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "4.152.0"
  }
}
